<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The glasses are a USB device; the phone acts as host. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- The observer's position: every look angle is computed from it. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <application>
        <!-- A second icon that starts the app on the glasses (see the class). Own process,
             so it can stop the app's. -->
        <activity
            android:name="org.vraeroscan.viture.LaunchOnGlassesActivity"
            android:exported="true"
            android:label="VRAeroScan (glasses)"
            android:process=":launch"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The phone-screen control panel, shown beside the app while it runs on the
             glasses. Its own task, so it lives on the phone display independently. -->
        <activity
            android:name="org.vraeroscan.viture.ControlPanelActivity"
            android:exported="false"
            android:label="VRAeroScan controls"
            android:taskAffinity="org.vraeroscan.controls"
            android:excludeFromRecents="true"
            android:resizeableActivity="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <!-- Godot v2 plugin registration: name → class. -->
        <meta-data
            android:name="org.godotengine.plugin.v2.VitureGlasses"
            android:value="org.vraeroscan.viture.VitureGlassesPlugin" />
    </application>
</manifest>
