<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The glasses are a USB device; the phone acts as host. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- The observer's position: every look angle is computed from it. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <application>
        <!-- Godot v2 plugin registration: name → class. -->
        <meta-data
            android:name="org.godotengine.plugin.v2.VitureGlasses"
            android:value="org.vraeroscan.viture.VitureGlassesPlugin" />
    </application>
</manifest>
