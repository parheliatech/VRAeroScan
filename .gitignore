# Viture binaries, kept out of the source tree. vendor/viture/ holds SpaceWalker's APK and the
# glasses libraries extracted from it (libglasses-jni.so, libglasses-internal.so, ...). Viture
# makes them freely available; the app needs them to talk to the glasses, and the release APK
# bundles them.
vendor/

# Editors
.vs/
.idea/
.vscode/

# Builds
*.apk
*.aab
*.app

# OS
.DS_Store
Thumbs.db

# Python scratch (prototypes live in the session scratchpad, not the repo)
__pycache__/
*.pyc
venv/
