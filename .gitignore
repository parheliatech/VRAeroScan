# Viture binaries, local only. vendor/viture/ holds SpaceWalker's APK and the glasses
# libraries extracted from it (libglasses-jni.so, libglasses-internal.so) - Viture's
# proprietary code, used locally to talk to the glasses and never redistributed.
vendor/

# Editors
.vs/
.idea/
.vscode/

# Builds
*.apk
*.aab
*.app

# OS
.DS_Store
Thumbs.db

# Python scratch (prototypes live in the session scratchpad, not the repo)
__pycache__/
*.pyc
venv/
